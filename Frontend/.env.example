# Backend API base URL (without trailing slash)
# For local development, this should point to your FastAPI backend
# Default: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: API Key for authentication (if backend requires it)
# Uncomment and set if your backend has API_KEY environment variable set
# VITE_API_KEY=your-api-key-here
