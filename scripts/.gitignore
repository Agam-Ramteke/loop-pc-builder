# Python cache & build
__pycache__/
*.py[cod]
*.egg
*.egg-info/
dist/
build/
*.log

# Virtual Environments
venv/
env/
*.env

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Scrapy/Selenium
.scrapy/
selenium_screenshots/
*.har

# Data directories (snapshots, raw dumps)
Raw_data/
individual_snapshots/
product_images/

# Ignore large dump formats globally
*.db
*.sqlite
*.html
*.csv
*.jsonl
*.parquet
*.zip
*.tar.gz

# Allow configs & small JSONs
!*.config.json
!config.json

# Node/JS stuff if any
node_modules/
*.tgz

# Logs
*.log

# Misc large files
*.mp4
*.mov
*.avi
*.mkv
*.pdf
*.img


